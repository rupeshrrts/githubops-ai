# GitHubOps AI configuration.
# Local: `npm run setup` copies this to .env.local and generates the secrets marked (auto).
# Vercel: set these in Project Settings -> Environment Variables.

# ---------------------------------------------------------------- Database (required)
# Any Postgres 14+. Supabase: Connect -> "Transaction pooler" (port 6543). Don't use the Session pooler
# (port 5432): its 15-connection limit fills up on Vercel and the site can't reach the database.
# Neon: added automatically by the Vercel Marketplace integration.
DATABASE_URL=
# Optional: PEM of the server's CA to verify TLS strictly (e.g. Supabase's CA certificate). Use \n for newlines.
DATABASE_SSL_CA=

# ---------------------------------------------------------------- Auth (required)
# (auto) Session signing secret.
AUTH_SECRET=
# GitHub OAuth App (github.com/settings/developers). Callback: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---------------------------------------------------------------- Security (required)
# (auto) 32 random bytes, base64. Encrypts stored GitHub tokens. Keep it stable: changing it
# makes stored tokens unreadable and users must sign in again.
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- AI model (required)
# Any OpenAI-compatible endpoint with tool calling. Key from https://build.nvidia.com
NVIDIA_API_KEY=
# Fast and reliable at tool calling (~1-2 s). openai/gpt-oss-20b also works but is much slower on the free tier.
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------------------------------------------------------------- Access control (optional)
# GitHub logins that are always admins (comma-separated). If empty, the FIRST user to sign in becomes admin.
ADMIN_GITHUB_LOGINS=
# Role for everyone else: viewer, member, maintainer or admin.
DEFAULT_ROLE=member
# OAuth scopes requested at sign-in. Leave unset for full access (repo, delete_repo, workflow, admin:org, ...).
# GITHUB_SCOPES=read:user repo

# ---------------------------------------------------------------- Limits and automation (optional)
# AI requests per user per day.
DAILY_MESSAGE_LIMIT=50
# (auto) Protects /api/cron/sync. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=
# Users refreshed per daily cron run.
CRON_SYNC_BATCH=25
