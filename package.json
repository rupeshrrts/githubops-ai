{
  "name": "githubops-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Talk to GitHub in plain English. Reads run instantly; every write waits for your approval.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:setup": "node scripts/setup.mjs --db-only",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/setup.mjs --db-only --if-configured && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/openai": "^1.7.0",
    "@octokit/rest": "^22.0.1",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
